{
  "thresholds": {
    "Rupture": {
      "alert_above": 0.6,
      "description": "Pipeline wall rupture — immediate shutdown risk"
    },
    "Deformation": {
      "alert_above": 0.7,
      "description": "Structural deformation — schedule inspection"
    },
    "Disconnect": {
      "alert_above": 0.65,
      "description": "Pipeline segment disconnection — high risk"
    },
    "Obstacle": {
      "alert_above": 0.8,
      "description": "Foreign obstacle in pipeline — monitor"
    },
    "Deposition": {
      "alert_above": 0.75,
      "description": "Material deposition buildup — monitor and schedule cleaning"
    },
    "Misalignment": {
      "alert_above": 0.7,
      "description": "Pipeline segment misalignment — schedule inspection"
    }
  },
  "actions": {
    "Rupture":       "HALT_PIPELINE",
    "Disconnect":    "HALT_PIPELINE",
    "Deformation":   "SCHEDULE_MAINTENANCE",
    "Misalignment":  "SCHEDULE_MAINTENANCE",
    "Obstacle":      "MONITOR",
    "Deposition":    "MONITOR"
  },
  "default_action": "MONITOR"
}
